#!/bin/sh

# Adds or removes @ALIAS@, a short name for @BINARY@, with links of the same
# name for its bash completion and its manual page. A name that a file of
# another owner holds is kept as it is. No link is added if @ALIAS@ itself is
# held, or if the PATH already finds an @ALIAS@ that is not @BINARY@.
# DESTDIR, if set, is the root of a staged install, and the PATH of this
# computer then does not apply.

set -eu

binary=@BINARY@
alias=@ALIAS@
root=${DESTDIR:-}
targets="@BINDIR@/$binary @COMPLETIONDIR@/$binary
@MANDIR@/$binary.1 @MANDIR@/$binary.1.gz"

add()
{
	command=$root@BINDIR@/$alias

	if ! free "$command" && ! ours "$command" "$binary"; then
		return
	fi

	if [ -z "$root" ] && other_on_path; then
		return
	fi

	for target in $targets; do
		link=$(link_of "$root$target")

		if [ -e "$root$target" ] && free "$link"; then
			ln -s "${target##*/}" "$link"
		fi
	done
}

free()
{
	[ ! -e "$1" ] && [ ! -L "$1" ]
}

link_of()
{
	echo "${1%/*}/$alias${1##*/$binary}"
}

other_on_path()
{
	found=$(command -v "$alias") || return 1
	[ "$(basename "$(readlink -f "$found")")" != "$binary" ]
}

ours()
{
	[ "$(readlink "$1")" = "$2" ]
}

remove()
{
	for target in $targets; do
		link=$(link_of "$root$target")

		if ours "$link" "${target##*/}"; then
			rm "$link"
		fi
	done
}

case $1 in
add) add ;;
remove) remove ;;
esac
